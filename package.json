{
  "name": "ai-trading-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Resilient, auditable, single-user automated NSE trading platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "backtest": "ts-node scripts/run-backtest.ts",
    "backfill": "ts-node scripts/backfill.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js && node scripts/build-console.js",
    "build:console": "node scripts/build-console.js",
    "build:static": "node scripts/build-static.js",
    "start": "node dist/main.js",
    "smoke": "ts-node scripts/smoke-serverless.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.11.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "ws": "^8.21.3"
  }
}
